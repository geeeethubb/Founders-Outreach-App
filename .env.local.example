# ─── Supabase ────────────────────────────────────────────────────
# Create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OpenAI ──────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Google OAuth (per-user Gmail sending and reply sync) ────────
# Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials
# Consent screen scopes: openid, email, gmail.send, gmail.readonly
# (gmail.send and gmail.readonly are RESTRICTED scopes — fine in "Testing" mode
#  with test users; public use requires Google verification + a CASA assessment.)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must EXACTLY match an "Authorized redirect URI" registered on the client.
# Add both http://localhost:3000/api/google/callback and your prod URL.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Base64-encoded 32-byte key used to encrypt stored refresh tokens (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_TOKEN_ENCRYPTION_KEY=your-base64-32-byte-key

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Anthropic (all agentic scouting, research, tailoring) ───────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Apollo (people enrichment) ──────────────────────────────────
APOLLO_API_KEY=...

# ─── DataForSEO (OPTIONAL — paid Google Jobs search) ─────────────
# Leave these unset and nothing breaks: the source reports itself unconfigured,
# the registry skips it by name, and discovery runs entirely on the free ATS
# adapters and public feeds. Set them only to buy the LinkedIn/Indeed market
# through Google's public jobs results.
# Why this provider (docs/JOB_SOURCE_MATRIX.md, surveyed 2026-08-31): it is the
# only Google Jobs vendor with a real structured internship filter
# (employment_type: intern), and at $0.0006 per 10 results — ~$0.06 per 1,000
# jobs — it is roughly 75x cheaper per job than the next usable option.
# $50 minimum, pay-as-you-go, at https://app.dataforseo.com/api-access
# Both are required; a login without a password counts as unconfigured.
# DATAFORSEO_LOGIN=you@example.com
# DATAFORSEO_PASSWORD=your-api-password

# ─── Career OS ───────────────────────────────────────────────────
# Path to the master résumé DOCX used to seed the Evidence Bank (never committed)
CAREER_MASTER_RESUME_PATH=./Zuyu_Resume.docx
# Local mirror for generated documents when Supabase Storage is unavailable (gitignored)
CAREER_OUTPUT_DIR=./.career-out
# Shared secret for the scheduled verification route (/api/career/cron/verify)
CRON_SECRET=change-me
# On Vercel the daily crons in vercel.json (/api/career/cron/sweep, /verify)
# answer 503 without it, and `npm run build` REFUSES a production build that
# lacks it. Any long random string; set it for all environments.
#
# ─── Durable scout runs: where the worker is ─────────────────────
# POST /api/scout and POST /api/career/scout only QUEUE a run, then dispatch a
# worker at this same deployment (POST /api/scout/worker). That dispatch carries
# the run's single-use claim token, so the address must be chosen by the SERVER
# — never by a request header, which anyone can forge into a blind SSRF that
# also leaks the token. The resolution order (lib/career/scout/worker-target.ts):
#
#   SCOUT_WORKER_BASE_URL           explicit, wins everywhere
#   VERCEL_URL + bypass header      when VERCEL_AUTOMATION_BYPASS_SECRET is set
#   VERCEL_PROJECT_PRODUCTION_URL   production only: the stable alias
#   NEXT_PUBLIC_APP_URL             production only, https, not loopback
#   (unresolved)                    a preview with none of the above: refused
#
# Off Vercel: SCOUT_WORKER_BASE_URL, then NEXT_PUBLIC_APP_URL above, then a
# Host / X-Forwarded-Host header ONLY when it names this machine (localhost,
# 127.0.0.1) — which is what makes `next dev` work with no configuration.
#
# ON VERCEL, DO ONE OF THESE TWO THINGS. Without either, the address falls back
# to VERCEL_URL — the PER-DEPLOYMENT hostname (`app-<hash>-<scope>.vercel.app`),
# which is exactly what Deployment Protection guards. The app's POST to itself
# gets a 401 and the run stays queued; before this pass that 401 was recorded as
# a successful dispatch, and a run once sat queued for 328 minutes this way.
#
#   1. Enable "Protection Bypass for Automation" in the Vercel project
#      (Settings → Deployment Protection). Vercel then provides
#      VERCEL_AUTOMATION_BYPASS_SECRET to every deployment, the app sends it as
#      `x-vercel-protection-bypass` to its OWN hosts only, and previews work too.
#      Never set this variable by hand and never put it in .env.local.
#   2. Or pin the STABLE PRODUCTION DOMAIN, not the deployment hash URL:
# SCOUT_WORKER_BASE_URL=https://your-app.vercel.app
#      A loopback value (localhost, 127.0.0.1) on Vercel fails the build.
#
# Locally, set it only when the app answers at an address none of the above
# describes — a tunnel, or a reverse proxy on a different origin.
# SCOUT_WORKER_BASE_URL=https://your-tunnel.example.dev
#
# The worker authenticates with the run's claim token, not with a shared secret.
# If a dispatch never lands, polling the run re-dispatches it, and
# `npm run career:scout -- --run <id>` executes a queued run from the CLI.
#
# ─── Vercel system variables (read, never set) ───────────────────
# VERCEL, VERCEL_ENV (production | preview | development), VERCEL_URL,
# VERCEL_PROJECT_PRODUCTION_URL and VERCEL_DEPLOYMENT_ID come from Vercel and
# ONLY when "Automatically expose System Environment Variables" is on (Settings
# → Environment Variables). With it off, every Vercel branch of the code thinks
# it is running locally and would dispatch scouting to localhost, so a build
# that sees VERCEL without VERCEL_ENV fails. Leave them out of .env.local.
#
# ─── Invocation budget (testing only) ────────────────────────────
# A worker leg plans on 280 s under Vercel's 300 s function ceiling, or 20 min
# locally (lib/runs/deadline.ts). This override is for local tests that want a
# hosted-sized budget; on Vercel it is reported as a warning and should be
# removed. Milliseconds.
# SCOUT_INVOCATION_BUDGET_MS=280000
#
# ─── Checking the configuration offline ──────────────────────────
# `npm run check:deploy` judges this environment with no network or database
# (lib/runs/deploy-config.ts) and EXITS NON-ZERO on a configuration that cannot
# work: it runs first in `npm run build`, so an invalid Vercel configuration is
# undeployable. Locally it only warns. `npm run check:worker-env` is the same
# judgement with the resolved worker address printed in full. It also refuses a
# build in which any NEXT_PUBLIC_* variable carries the VALUE of a server secret
# — everything named NEXT_PUBLIC_* is compiled into the browser bundle.
# Optional: which profile the career:* / evidence:* CLIs act on. Not needed with one profile.
CAREER_USER_ID=
